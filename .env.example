# Copy to .env for local development. docker-compose sets its own values for the
# containers; .env is mainly for running tests / scripts on the host.

# SQLAlchemy URL (psycopg v3 driver). Use localhost when running on the host,
# "db" when running inside the compose network.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/reservations

# Frontend origin(s) allowed to call /api/* (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Politely decline new phone calls when true (Phase 5+).
KILL_SWITCH=false

# --- secrets for later phases (leave blank for Phase 1-2) ---
OPENAI_API_KEY=
TWILIO_AUTH_TOKEN=
PUBLIC_HOST=
